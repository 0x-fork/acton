[server]
bind_addr = "127.0.0.1:3000"
# api_key = "migration-api-key"
read_only = false
# Deny source/ABI access and verification for these code hashes, including existing bundles.
# GET/HEAD /api/v1/verification/status continues to return the actual verification status.
# Accepts 64-character hexadecimal hashes (case-insensitive) or base64 hashes.
# Blocked hashes are also excluded from listings, ABI responses, and statistics.
# Restart the service after changes. Docker env: VERIFIER_BLOCKED_CODE_HASHES=hash1,hash2.
blocked_code_hashes = []

[logging]
# Supported values: trace, debug, info, warn, error.
level = "info"

[toncenter]
# mainnet_base_url = "https://toncenter.com"
# mainnet_api_key = "your-api-key"
# testnet_base_url = "https://testnet.toncenter.com"
# testnet_api_key = "your-api-key"

[payment]
# Supported values: mainnet, testnet.
primary_network = "testnet"
# Required in production. Use a raw basechain address on the selected network.
# address = "0:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# min_amount_nano = 500000000 # 0.5 GRAM
ledger_path = "verifier-payments.sqlite3"

[source_repository]
# path = "source-repo"
remote = "origin"
storage_root = "sources"
# branch = "main"
commit_enabled = true
push_enabled = true
author_name = "ton-verifier"
author_email = "ton-verifier@example.invalid"

[registry_index]
path = "verifier-index.sqlite3"

[compiler]
# All compilers and versions are allowed unless matched by a rule below.
# Compiler names are case-insensitive; versions are compared as literal strings.
# A name matches all versions; name@version matches one exact version, including suffixes.
# For example: ["tact", "func@0.4.4", "tolk@1.4.1"]. No range or wildcard expansion.
# Disabled compilers are rejected before payment and compilation.
# Acton <=1.2.0 is exempt for backward compatibility. Blueprint requires >=0.47.1.
# Docker env: VERIFIER_COMPILER_DISABLED=tact,func@0.4.4 (used when generating config).
disabled = []
node_bin = "node"
worker_path = "compiler-worker/compile.mjs"
timeout_ms = 10000
# Set to -1 to allow unlimited concurrent compilations.
max_concurrent_compilations = 1

[upload_limits]
max_request_bytes = 524288
