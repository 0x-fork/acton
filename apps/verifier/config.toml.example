[server]
bind_addr = "127.0.0.1:3000"
# api_key = "migration-api-key"

[logging]
# Supported values: trace, debug, info, warn, error.
level = "info"

[network]
# Payment verification supports only testnet.
name = "testnet"

[toncenter]
# base_url = "https://testnet.toncenter.com"
# api_key = "your-api-key"

[payment]
# Required in production. Use a raw basechain address.
# address = "0:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# min_amount_nano = 500000000 # 0.5 GRAM
ledger_path = "verifier-payments.sqlite3"

[source_repository]
# path = "source-repo"
remote = "origin"
storage_root = "sources"
# branch = "main"
commit_enabled = true
push_enabled = true
author_name = "ton-verifier"
author_email = "ton-verifier@example.invalid"

[registry_index]
path = "verifier-index.sqlite3"

[compiler]
node_bin = "node"
worker_path = "compiler-worker/compile.mjs"
timeout_ms = 10000

[upload_limits]
max_request_bytes = 16777216
max_json_file_bytes = 1048576
max_tolk_file_bytes = 524288
max_func_file_bytes = 524288
max_tact_file_bytes = 524288
