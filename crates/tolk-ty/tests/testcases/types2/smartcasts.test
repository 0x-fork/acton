========================================================================
Nested if smartcasts to non nullable value
========================================================================
fun main(cond: bool) {
    val value = cond ? 10 : null;
    val value2 = cond ? 10 : null;

    if (value == null) {
        if (value2 != null) {
            value;
//!         ^ null
            value2;
//!         ^ int
        } else {
            value;
//!         ^ null
            value2;
//!         ^ null
        }
        return;
    } else {
        value;
//!     ^ int
        value2;
//!     ^ int?

        if (value2 == null) {
            value;
//!         ^ int
            value2;
//!         ^ null
            return;
        } else {
            value;
//!         ^ int
            value2;
//!         ^ int
        }
    }

    value;
//! ^ int
    value2;
//! ^ int
}
------------------------------------------------------------------------
ok

========================================================================
Assign smartcast
========================================================================
fun main(): void {
    val name: int | string = 10;
//!     ^ int | string

    name;
//! ^ int

    name = "";
//! ^ int | string

    name;
//! ^ string
}
------------------------------------------------------------------------
ok

========================================================================
Assign smartcast with tuple
========================================================================
fun main(): void {
    val [name: int | string] = [10];
//!      ^ int | string

    name;
//! ^ int

    name = "";
//! ^ string

    name;
//! ^ string
}
------------------------------------------------------------------------
ok

========================================================================
Assign smartcast with tensor
========================================================================
fun main(): void {
    val (
        name: int | string,
//!     ^ int | string
        other: string?
//!     ^ string?
    ) = (10, null);

    name;
//! ^ int
    other;
//! ^ null

    name = "";
//! ^ int | string
    other = "";
//! ^ string?

    name;
//! ^ string
    other;
//! ^ string
}
------------------------------------------------------------------------
ok

========================================================================
Tolk 1.5 reanchor and least common ancestor
========================================================================
type BalanceDict = dict

type TensorLcaFirstSlotSmart = (int, int) | (slice, int)

fun test83(case: int) {
    var x: TensorLcaFirstSlotSmart = case == 0 ? (10, 1) : ("00000020".hexToSlice(), 2);
    if (x is (int, int)) {

        val observed1 = x;
//!         ^ (int, int)

    } else {

        val observed2 = x;
//!         ^ (slice, int)

    }

        val observed3 = x;
//!         ^ TensorLcaFirstSlotSmart

    return match (x) {
        (int, int) => x.0 + x.1,
        (slice, int) => x.0.loadInt(32) + x.1,
    };
}

struct ReanchorMsg1 {
    value: int
}

struct ReanchorMsg2 {
    value: int
}

type OneMessage = ReanchorMsg1
type AllowedMessages = ReanchorMsg1 | ReanchorMsg2
type MaybeCell = cell?

struct ReanchorHolder {
    maybeCell: MaybeCell
    oneMessage: OneMessage
}

struct OtherHolder {
    other: int
}

struct DeepLeaf {
    before1: int
    before2: int
    before3: int
    sub: MaybeCell
}

struct DeepOtherLeaf {
    other: int
}

type DeepNode = DeepLeaf | DeepOtherLeaf
type DeepField = (DeepNode, int)?

struct DeepHolder {
    before1: int
    before2: int
    field: DeepField
    after: int
}

type AnyDeepHolder = DeepHolder | OtherHolder

struct DictTensorHolder {
    before: int
    pair: (dict, BalanceDict)
}


