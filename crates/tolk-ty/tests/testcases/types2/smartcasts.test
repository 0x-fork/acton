========================================================================
Reanchor generic fields, bool alias matches and coalesce reachability
========================================================================
type OptionalCell = cell?;
type Flag = bool;
struct Box<T> { value: T }

fun checkGenericField(holder: Box<OptionalCell>) {
    if (holder.value != null) {}
    val observed1 = holder.value;
//!     ^ OptionalCell
}

fun checkBoolMatch(flag: Flag, value: int?) {
    match (flag) {
        true => { value = 1; }
        false => { value = 2; }
    }
    val observed2 = value;
//!     ^ int
}

fun checkCoalesceAssignment(value: int?) {
    var alwaysNull: int? = null;
    alwaysNull ?? (value = 1);
    val observed3 = value;
//!     ^ int
    value = null;
    1 ?? (value = 2);
    val observed4 = value;
//!     ^ null
}

fun main() {}
------------------------------------------------------------------------
ok

